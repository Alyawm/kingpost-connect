$ PROGRAM INFORMATION
  PROGRAM  "ETABS"  VERSION "21.0.0"

$ CONTROLS
  UNITS  "KN"  "M"  "C"
  TITLE1  "Two storey frame"

$ STORIES - IN SEQUENCE FROM TOP
  STORY "Roof"  HEIGHT 3.5
  STORY "Level 1"  HEIGHT 4
  STORY "Base"  ELEV 0

$ GRIDS
  GRID "G1"  LABEL "A"  DIR "X"  COORD 0
  GRID "G1"  LABEL "B"  DIR "X"  COORD 6

$ POINT COORDINATES
  POINT "1"  0 0
  POINT "2"  6 0
  POINT "3"  6 5
  POINT "4"  0 5

$ LINE CONNECTIVITIES
  LINE  "C1"  COLUMN  "1"  "1"  1
  LINE  "C2"  COLUMN  "2"  "2"  1
  LINE  "B1"  BEAM  "1"  "2"  0
  LINE  "D1"  BRACE  "2"  "1"  1

$ AREA CONNECTIVITIES
  AREA  "F1"  FLOOR  4  "1"  "2"  "3"  "4"  0 0 0 0

$ MATERIAL PROPERTIES
  MATERIAL "C30/37"  TYPE "Concrete"  GRADE "C30/37"  WEIGHTPERVOLUME 24.99
  MATERIAL "C30/37"  SYMTYPE "Isotropic"  E 33000000  U 0.2  A 0.00001
  MATERIAL "S355"  TYPE "Steel"  WEIGHTPERVOLUME 76.97
  MATERIAL "S355"  SYMTYPE "Isotropic"  E 210000000  U 0.3

$ FRAME SECTIONS
  FRAMESECTION  "C800X800"  MATERIAL "C30/37"  SHAPE "Concrete Rectangular"  D 0.8  B 0.8
  FRAMESECTION  "B800X700"  MATERIAL "C30/37"  SHAPE "Concrete Rectangular"  D 0.8  B 0.7
  FRAMESECTION  "UB406X178X54"  MATERIAL "S355"  SHAPE "Steel I/Wide Flange"  D 0.4026  B 0.1777  TF 0.0109  TW 0.0077

$ SLAB PROPERTIES
  SHELLPROP  "Slab200"  PROPTYPE  "Slab"  MATERIAL "C30/37"  MODELINGTYPE "ShellThin"  SLABTYPE "Slab"  SLABTHICKNESS 0.2

$ POINT ASSIGNS
  POINTASSIGN  "1"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "2"  "Base"  RESTRAINT "UX UY UZ"

$ LINE ASSIGNS
  LINEASSIGN  "C1"  "Level 1"  SECTION "C800X800"  ANG 0
  LINEASSIGN  "C2"  "Level 1"  SECTION "C800X800"
  LINEASSIGN  "C1"  "Roof"  SECTION "C800X800"
  LINEASSIGN  "C2"  "Roof"  SECTION "C800X800"
  LINEASSIGN  "B1"  "Level 1"  SECTION "B800X700"  RELEASE "M3I M3J"
  LINEASSIGN  "B1"  "Roof"  SECTION "UB406X178X54"
  LINEASSIGN  "D1"  "Roof"  SECTION "UB406X178X54"

$ AREA ASSIGNS
  AREAASSIGN  "F1"  "Level 1"  SECTION "Slab200"

$ LOAD PATTERNS
  LOADPATTERN "Dead"  TYPE "Dead"  SELFWEIGHT 1
  LOADPATTERN "Live"  TYPE "Live"  SELFWEIGHT 0
  LOADPATTERN "Wind"  TYPE "Wind"  SELFWEIGHT 0

$ LOAD COMBINATIONS
  COMBO "ULS1"  TYPE "Linear Add"
  COMBO "ULS1"  LOADCASE "Dead"  SF 1.35
  COMBO "ULS1"  LOADCASE "Live"  SF 1.5

$ POINT OBJECT LOADS
  POINTLOAD  "2"  "Roof"  TYPE "FORCE"  LC "Wind"  FX 12  FY 0  FZ 0  MX 0  MY 0  MZ 0

$ FRAME OBJECT LOADS
  LINELOAD  "B1"  "Level 1"  TYPE "UNIFF"  DIR "GRAV"  LC "Live"  FVAL 15
  LINELOAD  "B1"  "Roof"  TYPE "TRAPF"  DIR "GRAV"  LC "Dead"  FSTART 5  FEND 10  RDSTART 0  RDEND 1

$ AREA OBJECT LOADS
  AREALOAD  "F1"  "Level 1"  TYPE "UNIFF"  DIR "GRAV"  LC "Live"  FVAL 3

$ END OF MODEL FILE
